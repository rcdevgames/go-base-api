############################################
# Application / HTTP
############################################
APP_PORT=8080
LOG_DIR=logs
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

############################################
# Database
############################################
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=modmonolith
DB_SSL_MODE=disable

############################################
# Security
############################################
JWT_SECRET=changeme
INTER_SERVICE_TOKEN=internal-token
JWT_EXPIRATION_MINUTES=60
BCRYPT_COST=10
REFRESH_SECRET=changemerefresh
REFRESH_EXPIRATION_MINUTES=1440

############################################
# CORS
############################################
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-Internal-Token
CORS_ALLOW_CREDENTIALS=true
CORS_EXPOSED_HEADERS=
CORS_MAX_AGE=24h

############################################
# Storage / CDN
############################################
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=upload
CDN_BASE_URL=http://localhost:9090
CDN_PORT=9090

############################################
# S3 / MinIO (optional)
############################################
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true
S3_BASE_URL=
